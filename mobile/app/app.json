{
  "expo": {
    "name": "OpenCode Mobile",
    "slug": "opencode-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "opencode-mobile",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.umbecanessa.opencode-mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ]
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "OpenCode Mobile uses the microphone so you can dictate prompts to your agents.",
          "speechRecognitionPermission": "OpenCode Mobile turns your dictation into text before sending it as a prompt."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OpenCode Mobile reads photos and screenshots so you can attach them to prompts.",
          "cameraPermission": "OpenCode Mobile uses the camera so you can attach a photo to a prompt."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "usePrecompiledModules": false
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
